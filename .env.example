# Telegram Bot Credentials
BOT_TOKEN=8752722890:AAFPHBq-kD5C-XV4BfXrPasUitOhhmUYS1k
ADMIN_IDS=123456789,987654321
SUPPORT_CONTACT=@ipdokan

# Database Connection
MONGODB_URI=mongodb+srv://...

# Express Server Configuration
PORT=5001
APP_BASE_URL=http://localhost:5001

# ipdokan.com
# Product catalog (public API: <IPDOKAN_URL>/api/products)
IPDOKAN_URL=https://ipdokan.com
# Legacy: only used to cancel old WooCommerce orders
WOOCOMMERCE_URL=https://ipdokan.com
WOOCOMMERCE_CONSUMER_KEY=ck_your_read_write_consumer_key
WOOCOMMERCE_CONSUMER_SECRET=cs_your_consumer_secret
WOOCOMMERCE_WEBHOOK_SECRET=generate_a_long_random_webhook_secret

# ZiniPay: takes payment for bot / Mini App orders when ZINIPAY_API_KEY is set
# (Dashboard → Brands → Brand Key). Webhook: <APP_BASE_URL>/webhook/zinipay
ZINIPAY_API_KEY=
# ZiniPay only accepts a redirect_url on the brand's website domain. If the bot
# runs on another domain, point these at that site (the brand "Website URL",
# e.g. https://ipdokan.online/), or ZiniPay answers "Domain mismatch".
ZINIPAY_REDIRECT_URL=
ZINIPAY_CANCEL_URL=

# Cryptomus: crypto payments in USD (USDT, BTC, …) when both are set.
# Merchant UUID + *payment* API key from Cryptomus merchant settings.
# Webhook: <APP_BASE_URL>/webhook/cryptomus. Customers return to CRYPTOMUS_RETURN_URL
# (defaults to ZINIPAY_REDIRECT_URL).
CRYPTOMUS_MERCHANT_ID=
CRYPTOMUS_PAYMENT_KEY=
CRYPTOMUS_RETURN_URL=

# SSLCommerz: used when ZiniPay isn't configured (IPN: <APP_BASE_URL>/webhook/payment-ipn)
GATEWAY_SANDBOX=true
GATEWAY_STORE_ID=your_store_id
GATEWAY_STORE_PASSWORD=your_store_password
DEFAULT_CURRENCY=BDT
MOCK_PAYMENT=false

# Admin Dashboard Authentication
JWT_SECRET=generate_a_long_random_jwt_secret
ADMIN_PANEL_USERNAME=your_admin_username
ADMIN_PANEL_PASSWORD=use_a_strong_password
